<h2><%= t('actions.forgot_password') %></h2>

<% if Rails.env == "preit" %>
	<h1>Il reset della password deve essere fatto nell'ambiente di Produzione</h1>
	<h3>I dati dei profili utente (e relative password) sono copiati dall'ambiente di Produzione a quello di Preit allo scadere di ogni mezzora.<h3>
<% else %>

	<%= simple_form_for(resource, :as => resource_name, :url => password_path(resource_name), :html => { :method => :post }) do |f| %>
		<%= f.error_notification %>

		<div class="form-group">
			<%= f.input :email, :required => true, :autofocus => true %>
		</div>

		<div class="form-group">
			<%= button_tag(type: 'submit', class: "btn btn-primary") do %>
				<span class="glyphicon glyphicon-ok glyphicon-inverse"></span> <%= t('actions.send_reset_instructions') %>  
			<% end %>
		</div>
	<% end %>

	<%= render "devise/shared/links" %>
<% end %>
